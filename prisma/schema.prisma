generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id          String              @id @default(cuid())
  title       String
  eventDate   DateTime
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignments ServiceAssignment[]
}

model Team {
  id          String     @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  leaderPasswordHash String?
  roles       TeamRole[]
  members     TeamMember[]
}

model TeamRole {
  id          String              @id @default(cuid())
  name        String
  requiredByDefault Boolean         @default(false)
  qualified   RoleQualification[]
  teamId      String
  team        Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignments ServiceAssignment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model User {
  id          String              @id @default(cuid())
  fullName    String
  email       String?             @unique
  role        String              @default("volunteer")
  isApproved  Boolean             @default(true)
  accessToken String?             @unique
  status      String              @default("active")
  tags        String?
  blockouts   BlockoutDate[]
  memberships TeamMember[]
  qualifications RoleQualification[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignments ServiceAssignment[]
}

model ServiceAssignment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      TeamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  status    String   @default("pending")
  swapNote  String?
  reminder3dSentAt DateTime?
  reminder1dSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlockoutDate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
}

// Which ministries a volunteer belongs to.
model TeamMember {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

// Which roles a volunteer is trained for.
model RoleQualification {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   TeamRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}
